rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me()       { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function myTenant() { return me().tenantId; }
    function myRole()   { return me().role; }
    function isMember(tid) { return signedIn() && myTenant() == tid; }
    function isAdmin(tid)  { return isMember(tid) && (myRole() == 'OWNER' || myRole() == 'ADMIN'); }
    function isMoradaOperator() {
      let MORADA_OPERATOR_EMAILS = [
        'amandacaraca.profissional@gmail.com',
        'lima@moradacredito.com'
      ];
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in MORADA_OPERATOR_EMAILS;
    }

    match /auditLog/{entryId} {
      allow read: if isMoradaOperator();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'timestamp', 'targetTenantId', 'actorUid', 'actorRole',
          'action', 'resourceId', 'outcome'
        ])
        && request.resource.data.keys().hasAll([
          'timestamp', 'targetTenantId', 'actorUid',
          'action', 'resourceId', 'outcome'
        ])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.timestamp == request.time
        && request.resource.data.targetTenantId is string
        && request.resource.data.resourceId is string
        && (!('actorRole' in request.resource.data)
          || request.resource.data.actorRole in ['OWNER', 'ADMIN', 'ANALYST'])
        && request.resource.data.action in [
          'ACCESS_DENIED_CROSS_TENANT', 'SENSITIVE_EDIT_CPF',
          'EXPORT_DATA', 'OWNER_UID_CHANGE'
        ]
        && request.resource.data.outcome == (
          request.resource.data.action == 'ACCESS_DENIED_CROSS_TENANT'
            ? 'DENIED' : 'SENSITIVE_ACTION'
        );
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid
        || (resource.data.tenantId == myTenant() && isAdmin(resource.data.tenantId))
      );
      allow write: if false;
    }

    match /tenants/{tid} {
      allow read: if isMember(tid);
      allow write: if false;

      match /processes/{pid} {
        allow read:            if isAdmin(tid) || (isMember(tid) && resource.data.ownerUid == request.auth.uid);
        allow create:          if isAdmin(tid) || (isMember(tid) && request.resource.data.ownerUid == request.auth.uid);
        allow update, delete:  if isAdmin(tid) || (isMember(tid) && resource.data.ownerUid == request.auth.uid);
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
