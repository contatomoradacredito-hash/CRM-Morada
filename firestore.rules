rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Restrict all data: only authenticated users can read or write
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    match /processes/{processId} {
      allow read, write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
